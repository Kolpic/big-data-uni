# ─────────────────────────────────────────────────────────────────────────
# Example configuration. Copy to ".env" and adjust as needed:
#     cp .env.example .env
# All values are optional - config.py falls back to these defaults.
# ─────────────────────────────────────────────────────────────────────────

# ── Data generation (Faker) ──────────────────────────────────────────────
TOTAL_RECORDS=1000000     # total rows to generate (min. 500000 recommended)
NUM_FILES=10              # split the dataset across this many CSV part-files
NULL_RATE=0.05            # fraction of fields written as NULL (missing values)
CORRUPTION_RATE=0.02      # fraction of rows with invalid price/quantity
FAKER_LOCALE=en_US        # Faker locale (e.g. en_US, bg_BG)
RANDOM_SEED=42            # random seed for reproducibility
NUM_USERS=20000           # size of the simulated customer pool
HISTORY_DAYS=180          # transactions span this many days back from now

# ── Spark ─────────────────────────────────────────────────────────────────
SPARK_APP_NAME=BigDataDescriptiveAnalysis
SPARK_MASTER=local[*]     # use all CPU cores
SPARK_DRIVER_MEMORY=4g
SPARK_SHUFFLE_PARTITIONS=8

# ── Dask ──────────────────────────────────────────────────────────────────
DASK_N_WORKERS=4
DASK_THREADS_PER_WORKER=1
DASK_BLOCKSIZE=32MB

# ── Ray ───────────────────────────────────────────────────────────────────
RAY_NUM_CPUS=4
RAY_HIST_BINS=50
